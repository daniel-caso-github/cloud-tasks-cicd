# Config por entorno (12-factor) — ver wiki: config-por-entorno, config-endpoint-aws
# AWS_ENDPOINT_URL vacío/no seteado => AWS real. Con valor => se conmuta a LocalStack.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Nombres de recursos (ver wiki: naming-recursos)
TASKS_TABLE=tasks-local
ATTACHMENTS_BUCKET=attachments-local
EVENTS_QUEUE=task-events-local

LOG_LEVEL=INFO
