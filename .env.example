# Per-environment config (12-factor) — see wiki: config-por-entorno, config-endpoint-aws
# AWS_ENDPOINT_URL empty/unset => real AWS. With a value => switches to LocalStack.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Resource names (see wiki: naming-recursos)
TASKS_TABLE=tasks-local
ATTACHMENTS_BUCKET=attachments-local
EVENTS_QUEUE=task-events-local

LOG_LEVEL=INFO
